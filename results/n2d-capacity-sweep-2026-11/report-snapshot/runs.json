6,187,200,201,202,203,204","method":"final","runDir":"20261119-000626-n2d-sweep-levilamina-levioptimize-wine","harnessCommit":"a3ee0ae17e4d"},{"run":"32|LeviLamina+LeviOptimize (Wine)|2","vcpu":32,"server":"LeviLamina+LeviOptimize (Wine)","rep":2,"maxBots":102,"rssPeakGiB":1.81,"memLimitGiB":256,"steps":52,"invalidSteps":0,"machine":"hm1","serverCpus":"64,65,66,67,68,69,70,71,72,73,76,77,78,79,80,81,176,177,178,179,180,181,182,183,184,185,188,189,190,191,192,193","method":"final","runDir":"20261119-070046-n2d-sweep-levilamina-levioptimize-wine","harnessCommit":"a3ee0ae17e4d"},{"run":"32|LeviLamina+LeviOptimize (Wine)|3","vcpu":32,"server":"LeviLamina+LeviOptimize (Wine)","rep":3,"maxBots":104,"rssPeakGiB":1.82,"memLimitGiB":256,"steps":53,"invalidSteps":0,"machine":"z2","serverCpus":"64,77,78,79,80,81,82,83,84,85,86,87,93,94,95,96,176,189,190,191,192,193,194,195,196,197,198,199,205,206,207,208","method":"final","runDir":"20261119-021325-n2d-sweep-levilamina-levioptimize-wine","harnessCommit":"a3ee0ae17e4d"}],"meta":[{"label":"build_data.py","value":"#!/usr/bin/env python3\n\"\"\"Build the dashboard's data files from extract_local.py output (final-<host>.jsonl, one JSON object per valid run).\nruns.json: one row per run. curves.json: one row per run-minute. Each is {rows, meta}; meta carries this code.\"\"\"\nimport json, os\nHERE = os.path.dirname(os.path.abspath(__file__))\nLABEL = {'bds': 'BDS', 'endstone': 'Endstone', 'bds-wine': 'BDS (Wine)', 'levilamina-wine': 'LeviLamina (Wine)',\n         'levilamina-levioptimize-wine': 'LeviLamina+LeviOptimize (Wine)'}\nHOST = {'bp-hm1': 'hm1', 'bp-z1': 'z1', 'bp-z2': 'z2'}\nruns, curves = [], []\nfor h in ('bp-hm1', 'bp-z1', 'bp-z2'):\n    for line in open(os.path.join(HERE, f'final-{h}.jsonl')):\n        r = json.loads(line)\n        key = f\"{r['n']}|{LABEL[r['flavor']]}|{r['rep']}\"\n        early = []\n        if r['settleSec'] == 0: early.append('no 15 s settle (180 s hold)')\n        if r['botsPerWorker'] == 2: early.append('2 bots per worker')\n        if r['lagMs'] is None: early.append('lag threshold 50 ms')\n        if r['satFrac'] is None: early.append('any saturated second invalid')\n        runs.append({'run': key, 'vcpu': r['n'], 'server': LABEL[r['flavor']], 'rep': r['rep'], 'maxBots': r['max'],\n                     'rssPeakGiB': round(r['rssPeakMB'] / 1024, 2), 'memLimitGiB': 8 * r['n'],\n                     'steps': r['steps'], 'invalidSteps': r['invalidSteps'], 'machine': HOST[h],\n                     'serverCpus': ','.join(map(str, r['serverCpus'])), 'method': 'final' if not early else 'early: ' + '; '.join(early),\n                     'runDir': r['run'], 'harnessCommit': (r['harness'] or '')[:12]})\n        for m, bots, tps, p99, cpu, main, rss, botcpu in r['series']:\n            curves.append({'run': key, 'vcpu': r['n'], 'server': LABEL[r['flavor']], 'rep': r['rep'], 'minute': m, 'bots': bots,\n                           'tps': tps, 'tickP99Ms': p99, 'serverCores': cpu, 'mainThreadUtil': main, 'rssMiB': rss, 'botCores': botcpu})\nruns.sort(key=lambda x: (x['vcpu'], x['server'], x['rep'])); curves.sort(key=lambda x: (x['vcpu'], x['server'], x['rep'], x['minute']))\ncode = [{'label': 'build_data.py', 'value': open(__file__).read(), 'type': 'code', 'lang': 'python'},\n        {'label': 'extract_local.py (per-run extraction from bedperf samples.jsonl)', 'value': open(os.path.join(HERE, 'extract_local.py')).read(), 'type': 'code', 'lang': 'python'},\n        {'label': 'Input', 'value': 'bedperf run dirs runs/sweep/N<vcpu>/<flavor>/r<rep>/<run>/ from bp-hm1, bp-z1, bp-z2 (archived as bp-*.tar.xz)'}]\njson.dump({'rows': runs, 'meta': code}, open(os.path.join(HERE, 'runs.json'), 'w'), separators=(',', ':'))\njson.dump({'rows': curves, 'meta': code}, open(os.path.join(HERE, 'curves.json'), 'w'), separators=(',', ':'))\nprint(len(runs), 'runs,', len(curves), 'curve rows')\n","type":"code","lang":"python"},{"label":"extract_local.py (per-run extraction from bedperf samples.jsonl)","value":"#!/usr/bin/env python3\n\"\"\"Per valid sweep run: 1-minute bins (bots, TPS, tick p99, CPU, main util, RSS, bot CPU) + summary. Prints JSON lines.\"\"\"\nimport json, glob, os, socket, statistics as S\nfrom collections import defaultdict\nimport sys\nH = sys.argv[1]; HOST = sys.argv[2]\nfor res in sorted(glob.glob(H + '/N*/*/r*/2*/result.json')):\n    d = os.path.dirname(res); parts = d.replace(chr(92), '/').split('/')\n    n, flavor, rep = int(parts[-4][1:]), parts[-3], int(parts[-2][1:])\n    r = json.load(open(res))\n    if r.get('invalidLimited') or not any(x.get('status') == 'ok' for x in r.get('repeats', [])): continue\n    cfg = json.load(open(d + '/config.json')); meta = json.load(open(d + '/meta.json'))\n    t0 = None; bins = defaultdict(lambda: defaultdict(list)); steps = []\n    for l in open(d + '/samples.jsonl'):\n        e = json.loads(l); k = e.get('kind'); x = e.get('data') or {}; t = e.get('t', 0)\n        if k == 'orch.repeat.start' and t0 is None: t0 = t; continue\n        if t0 is None: continue\n        b = int((t - t0) / 60000); f = bins[b]\n        if k == 'probe.sample' and x.get('windowMs'):\n            f['tps'].append(x.get('tps') or 0); f['p99'].append((x.get('interval') or {}).get('p99') or 0)\n        elif k == 'sys.sample':\n            f['cpu'].append((x.get('cpuPct') or 0) / 100); f['main'].append(((x.get('mainThread') or {}).get('util') or 0))\n            f['rss'].append((x.get('rssBytes') or 0) / 2**20)\n        elif k == 'bot.stats':\n            f['bots'].append(x.get('spawned') or 0); f['botcpu'].append(((x.get('loadgen') or {}).get('totalCores') or 0))\n        elif k == 'orch.step.end':\n            steps.append({'players': x.get('players'), 'tps': round(((x.get('tps') or {}).get('mean') or 0), 3) if isinstance(x.get('tps'), dict) else None})\n    series = []\n    for b in sorted(bins):\n        f = bins[b]\n        if not f['bots'] or not f['tps']: continue\n        series.append([b, max(f['bots']), round(S.mean(f['tps']), 3), round(max(f['p99']), 1), round(S.mean(f['cpu']), 3) if f['cpu'] else None,\n                       round(S.mean(f['main']), 3) if f['main'] else None, round(max(f['rss'])) if f['rss'] else None, round(S.mean(f['botcpu']), 2)])\n    st = [s for s in json.load(open(d + '/steps.json')) if not s.get('invalidReasons')]\n    srv = meta.get('server') or {}\n    print(json.dumps({'n': n, 'flavor': flavor, 'rep': rep, 'host': HOST, 'run': os.path.basename(d),\n                      'max': max(r.get('maxPlayers') or [0]), 'steps': len(st), 'invalidSteps': sum(1 for s in json.load(open(d + '/steps.json')) if s.get('invalidReasons')),\n                      'rssPeakMB': round(max(((s.get('rssBytes') or {}).get('max') or 0) for s in st) / 2**20),\n                      'serverCpus': (meta.get('placement') or {}).get('serverCpus'), 'harnessCpus': (meta.get('placement') or {}).get('harnessCpus'),\n                      'bds': srv.get('bdsVersion'), 'artifacts': [(a.get('name'), a.get('version')) for a in (srv.get('artifacts') or [])],\n                      'botsPerWorker': cfg['loadgen'].get('botsPerWorker'), 'settleSec': cfg['ramp'].get('settleSec'), 'holdSec': cfg['ramp'].get('holdSec'),\n                      'satFrac': (cfg.get('gates') or {}).get('loadgenSaturatedMaxFraction'), 'lagMs': (cfg['loadgen'].get('saturation') or {}).get('eventLoopP99Ms'),\n                      'harness': (meta.get('harness') or {}).get('git') if isinstance(meta.get('harness'), dict) else meta.get('harness'),\n                      'series': series}))\n","type":"code","lang":"python"},{"label":"Input","value":"bedperf run dirs runs/sweep/N<vcpu>/<flavor>/r<rep>/<run>/ from bp-hm1, bp-z1, bp-z2 (archived as bp-*.tar.xz)"}]}