{
  "name": "@bedperf/probe-addon",
  "version": "0.0.0",
  "private": true,
  "description": "Script API behavior pack that reports in-tick TPS/tick-interval/entity metrics to stdout",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p . && tsc -p tsconfig.pack.json",
    "test": "node --test \"src/**/*.test.ts\""
  },
  "dependencies": {
    "@bedperf/core": "workspace:*",
    "@minecraft/server": "2.11.0"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
